# Copier ce fichier en .env et renseigner des valeurs réelles.
# Ne jamais commiter le fichier .env lui-même.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS changer cette clé une fois des données chiffrées en base (elles deviendraient illisibles).
FIELD_ENCRYPTION_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données MySQL
DB_NAME=presence_saas_db
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# E-mail (Gmail SMTP) — laisser vide pour rester en mode console (aucun envoi réel).
# EMAIL_HOST_PASSWORD est un "mot de passe d'application" Google (16 caractères),
# PAS le mot de passe du compte Gmail — voir la validation en 2 étapes du compte.
DEFAULT_FROM_EMAIL=noreply@geopresence.local
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# CAPTCHA hCaptcha (CDC §13.4) — laisser vide désactive le CAPTCHA partout.
# Clés à obtenir sur https://dashboard.hcaptcha.com/
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Assistant GeoIA (CDC §15) — laisser AI_API_KEY vide désactive l'assistant
# partout. Jamais saisie via une page web, uniquement ici.
AI_ENABLED=False
AI_PROVIDER=OPENAI
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_LANGUAGE=fr
AI_ROLES_ALLOWED=SUPER_ADMIN,ADMIN,MANAGER,EMPLOYEE
AI_MONTHLY_QUOTA=500
AI_HISTORY_RETENTION_DAYS=30

# Sauvegardes (CDC §18.4) — clé AES-256, 32 octets encodés en base64.
# Générer avec : python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Ne JAMAIS changer cette clé une fois des sauvegardes créées (elles deviendraient illisibles).
BACKUP_ENCRYPTION_KEY=change-me
# Laisser vide en développement (utilise <racine du projet>/backups).
BACKUP_DIR=
# Second emplacement de stockage (CDC §18.4.3) — laisser vide si aucun volume distant n'est monté.
BACKUP_SECONDARY_DIR=
