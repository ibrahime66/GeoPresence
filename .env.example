# Copier ce fichier en .env et renseigner des valeurs réelles.
# Ne jamais commiter le fichier .env lui-même.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS changer cette clé une fois des données chiffrées en base (elles deviendraient illisibles).
FIELD_ENCRYPTION_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données MySQL
DB_NAME=presence_saas_db
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# E-mail (Gmail SMTP) — laisser vide pour rester en mode console (aucun envoi réel).
# EMAIL_HOST_PASSWORD est un "mot de passe d'application" Google (16 caractères),
# PAS le mot de passe du compte Gmail — voir la validation en 2 étapes du compte.
DEFAULT_FROM_EMAIL=noreply@geopresence.local
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
