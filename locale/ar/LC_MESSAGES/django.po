msgstr "اطرح سؤالك الأول على GeoIA."

msgid "Votre question…"
msgstr "سؤالك…"

msgid "Envoyer"
msgstr "إرسال"

msgid ""
"Fournisseur, clé API et limites d'utilisation de l'assistant conversationnel"
" (CDC §15.2)."
msgstr "المزوّد، مفتاح API، وحدود الاستخدام للمساعد الحواري."

msgid "Accès et limites"
msgstr "الوصول والحدود"

