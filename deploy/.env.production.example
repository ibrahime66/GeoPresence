# Copier ce fichier en .env à la racine du projet sur le VPS, et renseigner
# des valeurs réelles. Ne jamais commiter le fichier .env lui-même.

DJANGO_SETTINGS_MODULE=config.settings.production
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS changer cette clé une fois des données chiffrées en base (elles deviendraient illisibles).
FIELD_ENCRYPTION_KEY=change-me
# Domaine réel (ex. geopresence.mondomaine.com) — ou l'IP du VPS tant qu'il n'y a pas de nom de domaine.
DJANGO_ALLOWED_HOSTS=change-me

# Base de données MySQL (créée pendant l'installation, voir deploy/README.md)
DB_NAME=geopresence_db
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Cache/rate limiting partagé entre les workers Gunicorn (Redis installé en local sur le VPS).
REDIS_URL=redis://127.0.0.1:6379/1

# Suivi des erreurs — laisser vide tant qu'aucun compte Sentry n'est créé
# (fonctionne très bien sans, juste moins pratique pour déboguer à distance).
SENTRY_DSN=

# E-mail (Gmail SMTP) — laisser vide pour rester en mode console (aucun envoi réel).
# EMAIL_HOST_PASSWORD est un "mot de passe d'application" Google (16 caractères),
# PAS le mot de passe du compte Gmail.
# ⚠️ Si EMAIL_HOST_USER est renseigné, DEFAULT_FROM_EMAIL DOIT être cette même
# adresse Gmail, sinon les e-mails finissent en spam ou sont rejetés silencieusement.
DEFAULT_FROM_EMAIL=noreply@geopresence.local
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# CAPTCHA hCaptcha (CDC §13.4) — laisser vide désactive le CAPTCHA partout.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Assistant GeoIA (CDC §15) — laisser AI_API_KEY vide désactive l'assistant partout.
AI_ENABLED=False
AI_PROVIDER=OPENAI
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_LANGUAGE=fr
AI_ROLES_ALLOWED=SUPER_ADMIN,ADMIN,MANAGER,EMPLOYEE
AI_MONTHLY_QUOTA=500
AI_HISTORY_RETENTION_DAYS=30

# Sauvegardes (CDC §18.4) — clé AES-256, 32 octets encodés en base64.
# Générer avec : python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEY=change-me
BACKUP_DIR=
BACKUP_SECONDARY_DIR=
